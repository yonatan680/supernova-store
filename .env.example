# Public origin of the store. Required for payment return URLs and the webhook.
# Production must be https. Local Stripe testing may use http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Payment adapter id. Currently registered: stripe
# Leave empty until you have a live/test merchant account — checkout stays in "awaiting provider" mode.
PAYMENT_PROVIDER=

# --- Stripe (only when PAYMENT_PROVIDER=stripe) ---
# Dashboard → Developers → API keys. Secret key only. Never expose this to the browser.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint ${NEXT_PUBLIC_SITE_URL}/api/payments/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Optional: where paid/pending order JSON is stored (default: .data/orders)
# ORDER_STORE_DIR=

# Optional: transactional email after a verified payment.
# EMAIL_API_KEY=
# EMAIL_FROM=

# Also required for live charges: set a numeric shipping price in src/data/shipping.ts (0 = free).
